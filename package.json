{
  "name": "open-media-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "runtime:cli": "tsx --tsconfig tsconfig.runtime.json scripts/runtime-cli.ts",
    "typecheck:runtime": "tsc --noEmit -p tsconfig.runtime.json",
    "test:runtime": "vitest run tests/download-runtime.test.ts tests/node-runtime.test.ts tests/node-artifact-failure.test.ts tests/runtime-task-executors.test.ts tests/runtime-progressive-executor.test.ts tests/transport.test.ts",
    "build:runtime": "vite build --config vite.runtime.config.ts && tsc -p tsconfig.runtime-build.json && tsx --tsconfig tsconfig.runtime.json scripts/package-runtime.ts",
    "check:runtime": "tsx --tsconfig tsconfig.runtime.json scripts/check-runtime-build.ts",
    "test:e2e": "pnpm build && playwright test"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "fast-xml-parser": "5.11.0",
    "googlevideo": "4.1.1",
    "mux.js": "7.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "wxt": "0.21.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.0"
}
